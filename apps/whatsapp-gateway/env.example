# Copy this file to `.env`  ->  cp env.example .env
#
# ── Kapso (WhatsApp) ──────────────────────────────────────────────
# Project API key from `kapso login` / Kapso dashboard.
KAPSO_API_KEY=
# Phone number id of the WhatsApp number connected via `kapso setup`.
KAPSO_PHONE_NUMBER_ID=
# Kapso Meta proxy base url (default is fine).
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp
# Secret Kapso uses to sign webhook deliveries (HMAC-SHA256, header X-Webhook-Signature).
KAPSO_WEBHOOK_SECRET=

# ── Security ──────────────────────────────────────────────────────
# Comma-separated admin numbers (digits incl. country code, no +). ONLY these
# senders can inject tasks into Gru. Everyone else is ignored.
ADMIN_WHATSAPP_NUMBERS=34600111222

# ── Server ────────────────────────────────────────────────────────
PORT=8787
WEBHOOK_PATH=/webhooks/whatsapp

# ── Projects ──────────────────────────────────────────────────────
# JSON map: project name -> { "path": "<absolute repo path>" }.
PROJECTS_FILE=./projects.json
# Project used when a sender has not run /proyecto yet (optional).
DEFAULT_PROJECT=3A_ESTUDIO

# ── Gru ───────────────────────────────────────────────────────────
# Optional: force a provider for every task. Leave empty to let the Router decide.
GRU_DEFAULT_PROVIDER=
