{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@gru/shared/*": [
        "packages/shared/src/*"
      ],
      "@gru/kernel/*": [
        "packages/kernel/src/*"
      ],
      "@gru/providers/*": [
        "packages/providers/*"
      ],
      "@gru/skills/*": [
        "packages/skills/src/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "vendor",
    "node_modules",
    "dist"
  ]
}
