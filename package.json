{
  "name": "gru-orchestrator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "gru": "tsx apps/cli/src/index.ts",
    "postinstall": "node scripts/setup-cybersec.mjs --postinstall",
    "setup": "node scripts/setup-cybersec.mjs --postinstall && node scripts/setup-providers.mjs",
    "setup:check": "node scripts/setup-providers.mjs --check",
    "setup:yes": "node scripts/setup-providers.mjs --yes",
    "setup:cybersec": "node scripts/setup-cybersec.mjs",
    "setup:cybersec:check": "node scripts/setup-cybersec.mjs --check",
    "setup:legacy": "(pi --version || npm install -g pi) && curl -fsSL https://raw.githubusercontent.com/Gentleman-Programming/gentle-ai/main/scripts/install.sh | bash && pi install npm:gentle-pi && pi install npm:gentle-engram"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@gru/shared": "workspace:*",
    "@gru/provider-awesome-copilot": "workspace:*",
    "@gru/provider-deepagents": "workspace:*",
    "@gru/provider-ecc": "workspace:*",
    "@gru/provider-engram": "workspace:*",
    "@gru/provider-gentle-pi": "workspace:*",
    "@gru/provider-gentleman-cli": "workspace:*",
    "@gru/provider-local": "workspace:*",
    "@gru/provider-ruflo": "workspace:*",
    "execa": "^9.6.1",
    "yaml": "^2.9.0"
  }
}
